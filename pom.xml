<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ________________________________________________________________________________________________
         BORURIO ERP FISCAL BR — PROJETO MODULAR NACIONALIZADO
         Módulos: Core / App / Fiscal / Web (Main)
         Stack: Java 17 | Spring Boot 3.3.2 | MyBatis | MySQL 8.4 | Redis
         Padrões: DevSecOps | Multi-Module | OWASP | CI/CD | Docker
         Autor: Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
         Versão: 1.0.0
         ________________________________________________________________________________________________ -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.borurio</groupId>
    <artifactId>borurio-erp-br</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Borurio ERP Fiscal BR</name>
    <description>ERP Fiscal nacionalizado — Java 17 | Spring Boot 3.3.2 | MyBatis | DevSecOps</description>

    <!-- ________________________________________________________________________________________________
         ESTRUTURA DE MÓDULOS
         ________________________________________________________________________________________________ -->
    <modules>
        <module>borurio-core</module>
        <module>borurio-app</module>
        <module>borurio-fiscal</module>
        <module>borurio-web</module>
    </modules>

    <!-- ________________________________________________________________________________________________
         PROPRIEDADES GLOBAIS
         ________________________________________________________________________________________________ -->
    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.3.2</spring.boot.version>
        <mybatis.version>3.0.3</mybatis.version>
        <mysql.version>8.4.0</mysql.version>
        <redis.version>3.3.2</redis.version>
        <flyway.version>10.18.0</flyway.version>
        <owasp.version>9.0.9</owasp.version>
        <surefire.version>3.2.5</surefire.version>
        <jacoco.version>0.8.11</jacoco.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ________________________________________________________________________________________________
         GERENCIAMENTO CENTRAL DE DEPENDÊNCIAS
         ________________________________________________________________________________________________ -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ________________________________________________________________________________________________
         CONFIGURAÇÃO GLOBAL DE BUILD E PLUGINS
         ________________________________________________________________________________________________ -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- Compilador Java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Spring Boot (empacotamento do módulo principal) -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                    <configuration>
                        <skip>false</skip>
                    </configuration>
                </plugin>

                <!-- OWASP Dependency Check -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${owasp.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7.0</failBuildOnCVSS>
                        <format>HTML</format>
                        <outputDirectory>${project.build.directory}/security-reports</outputDirectory>
                        <skipProvidedScope>true</skipProvidedScope>
                        <skipTestScope>true</skipTestScope>
                    </configuration>
                </plugin>

                <!-- Jacoco (cobertura) -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Surefire (JUnit 5) - Testes desativados globalmente -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <skipTests>true</skipTests>
                        <useModulePath>false</useModulePath>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <testFailureIgnore>true</testFailureIgnore>
                    </configuration>
                </plugin>

                <!-- Recursos -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

    <!-- ________________________________________________________________________________________________
         REPOSITÓRIOS MAVEN
         ________________________________________________________________________________________________ -->
    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>maven-central-plugins</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- ________________________________________________________________________________________________
         PERFIS DE BUILD
         ________________________________________________________________________________________________ -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
        </profile>

        <profile>
            <id>hom</id>
            <properties>
                <spring.profiles.active>hom</spring.profiles.active>
            </properties>
        </profile>

        <profile>
            <id>prd</id>
            <properties>
                <spring.profiles.active>prd</spring.profiles.active>
            </properties>
        </profile>

        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${owasp.version}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- ________________________________________________________________________________________________
         DISTRIBUIÇÃO — CI/CD (GitHub Packages)
         ________________________________________________________________________________________________ -->
    <distributionManagement>
        <repository>
            <id>borurio-releases</id>
            <name>Borurio Maven Releases</name>
            <url>https://maven.pkg.github.com/BrunoDev-Fullstack/Borurio-ERP-Fiscal-BR</url>
        </repository>
        <snapshotRepository>
            <id>borurio-snapshots</id>
            <name>Borurio Maven Snapshots</name>
            <url>https://maven.pkg.github.com/BrunoDev-Fullstack/Borurio-ERP-Fiscal-BR</url>
        </snapshotRepository>
    </distributionManagement>

</project>
