<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ============================================================
         BORURIO ERP FISCAL BR – PROJETO MODULAR NACIONALIZADO
         Módulos: Core / App / Fiscal / Web (Main)
         Stack: Java 17, Spring Boot 3.3.2, MyBatis, MySQL 8.4, Redis
         Autor: Bruno Ribeiro – Dev Fullstack / DevSecOps
         ============================================================ -->

    <modelVersion>4.0.0</modelVersion>
    <groupId>br.com.borurio</groupId>
    <artifactId>borurio-erp-br</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Borurio ERP Fiscal BR</name>
    <description>ERP Fiscal nacionalizado – Java 17 / Spring Boot 3.3.2 / MyBatis / DevSecOps</description>

    <!-- ============================================================
         ESTRUTURA DE MÓDULOS
         ============================================================ -->
    <modules>
        <module>borurio-core</module>
        <module>borurio-app</module>
        <module>borurio-fiscal</module>
        <module>borurio-web</module>
    </modules>

    <!-- ============================================================
         PROPRIEDADES GLOBAIS
         ============================================================ -->
    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.3.2</spring.boot.version>
        <owasp.version>9.0.9</owasp.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <!-- ============================================================
         GERENCIAMENTO CENTRAL DE DEPENDÊNCIAS
         ============================================================ -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================
         CONFIGURAÇÃO DE BUILD E PLUGINS
         ============================================================ -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- =====================================================
                     Spring Boot (empacotamento e reempacotamento)
                     Apenas o módulo 'web' gera JAR executável.
                     ===================================================== -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                    <configuration>
                        <skip>false</skip>
                    </configuration>
                </plugin>

                <!-- Compilador Java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Testes (JUnit 5 / Surefire) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                    </configuration>
                </plugin>

                <!-- OWASP Dependency Check (DevSecOps) -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${owasp.version}</version>
                    <configuration>
                        <failBuildOnCVSS>7.0</failBuildOnCVSS>
                        <format>HTML</format>
                        <outputDirectory>${project.build.directory}/security-reports</outputDirectory>
                        <skipProvidedScope>true</skipProvidedScope>
                        <skipTestScope>false</skipTestScope>
                    </configuration>
                </plugin>

                <!-- Recursos / Codificação -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

    <!-- ============================================================
         REPOSITÓRIOS MAVEN
         ============================================================ -->
    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>maven-central-plugins</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- ============================================================
         PERFIS DE BUILD
         ============================================================ -->
    <profiles>

        <!-- Desenvolvimento (padrão local e Docker) -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
        </profile>

        <!-- Produção (CI/CD e Deploy) -->
        <profile>
            <id>prd</id>
            <properties>
                <spring.profiles.active>prd</spring.profiles.active>
            </properties>
        </profile>

        <!-- Varredura OWASP para pipeline -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${owasp.version}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

    <!-- ============================================================
         DISTRIBUIÇÃO (CI/CD – GitHub Packages)
         ============================================================ -->
    <distributionManagement>
        <repository>
            <id>borurio-releases</id>
            <name>Borurio Maven Releases</name>
            <url>https://maven.pkg.github.com/BrunoDev-Fullstack/Borurio-ERP-Fiscal-BR</url>
        </repository>
        <snapshotRepository>
            <id>borurio-snapshots</id>
            <name>Borurio Maven Snapshots</name>
            <url>https://maven.pkg.github.com/BrunoDev-Fullstack/Borurio-ERP-Fiscal-BR</url>
        </snapshotRepository>
    </distributionManagement>

</project>
