<?xml version="1.0" encoding="UTF-8"?>
<!--
==============================================================================
SCHEMA: tiposNFe_v4.00.xsd
______________________________________________________________________________
Propósito:
  Definir os tipos principais e auxiliares da Nota Fiscal Eletrônica (NF-e)
  versão 4.00, incluindo estruturas de envio (TEnviNFe), retorno (TRetEnviNFe),
  nota individual (TNFe) e protocolo de autorização (TProtNFe).

Base técnica:
  - NT 2025.002
  - Leiaute PL_010b v1.30 (SEFAZ)
  - Especificação W3C XML Schema 1.0

Ajustes aplicados:
  - Substituição de "xs:any" por "xs:anyType" (tipo válido W3C).
  - Remoção de atributos default redundantes e inválidos (xmlns).
  - Compatibilidade validada com parser Xerces (Java 17) e IntelliJ.
  - Estrutura ajustada para integração com schema consolidado NF-e.

Escopo:
  Ambientes: DEV / HOMOLOGAÇÃO / PRODUÇÃO
  Projeto: Borurio ERP Fiscal BR

Autor:
  Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
  Revisão 3.2.0 — Remoção do atributo 'xmlns' e validação final com Xerces
==============================================================================
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.portalfiscal.inf.br/nfe"
           targetNamespace="http://www.portalfiscal.inf.br/nfe"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- =============================================================
         1. Tipo principal — TEnviNFe (envio do lote)
         =============================================================
         Estrutura principal de envio do lote de NF-e (TEnviNFe),
         contendo o identificador do lote, o indicador de envio síncrono
         e até 50 documentos NF-e individuais.
    -->
    <xs:complexType name="TEnviNFe">
        <xs:annotation>
            <xs:documentation>
                Estrutura principal de envio do lote de NF-e (TEnviNFe).
                Contém o identificador do lote, o indicador de envio síncrono
                e até 50 documentos NF-e individuais (NFe).
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="idLote" type="xs:string"/>
            <xs:element name="indSinc" type="xs:string" minOccurs="0"/>
            <xs:element name="NFe" type="TNFe" maxOccurs="50"/>
        </xs:sequence>
        <xs:attribute name="versao" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =============================================================
         2. Tipo principal — TRetEnviNFe (retorno do lote)
         =============================================================
         Estrutura de retorno da SEFAZ após o envio de um lote de NF-e.
         Contém informações de ambiente, versão, código e motivo,
         além de dados opcionais do recibo (infRec).
    -->
    <xs:complexType name="TRetEnviNFe">
        <xs:annotation>
            <xs:documentation>
                Estrutura de retorno da SEFAZ após o envio de um lote de NF-e.
                Contém informações de ambiente, versão, código e motivo,
                além de dados opcionais do recibo (infRec).
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="tpAmb" type="xs:string"/>
            <xs:element name="verAplic" type="xs:string"/>
            <xs:element name="cStat" type="xs:string"/>
            <xs:element name="xMotivo" type="xs:string"/>
            <xs:element name="infRec" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="nRec" type="xs:string"/>
                        <xs:element name="tMed" type="xs:string" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="versao" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- =============================================================
         3. Tipo auxiliar — TNFe (nota individual)
         =============================================================
         Estrutura que representa uma NF-e individual.
         Os subelementos "infNFe" e "infNFeSupl" utilizam xs:anyType
         para permitir compatibilidade entre diferentes versões e mocks
         de teste sem comprometer a conformidade estrutural.
    -->
    <xs:complexType name="TNFe">
        <xs:annotation>
            <xs:documentation>
                Estrutura que representa uma NF-e individual.
                Os subelementos "infNFe" e "infNFeSupl" utilizam xs:anyType
                para permitir compatibilidade entre diferentes versões e mocks
                de teste sem comprometer a conformidade estrutural.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="infNFe" type="xs:anyType"/>
            <xs:element name="infNFeSupl" type="xs:anyType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- =============================================================
         4. Tipo auxiliar — TProtNFe (protocolo de autorização)
         =============================================================
         Estrutura do protocolo de autorização da NF-e, emitido pela SEFAZ.
         Inclui as informações do processamento e, opcionalmente,
         a assinatura digital XMLDSig (Signature).
    -->
    <xs:complexType name="TProtNFe">
        <xs:annotation>
            <xs:documentation>
                Estrutura do protocolo de autorização da NF-e, emitido pela SEFAZ.
                Inclui as informações do processamento e, opcionalmente,
                a assinatura digital XMLDSig (Signature).
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="infProt" type="xs:anyType"/>
            <xs:element name="Signature" type="xs:anyType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="versao" type="xs:string" use="required"/>
    </xs:complexType>

</xs:schema>
