<?xml version="1.0" encoding="UTF-8"?>
<!--
==============================================================================
SCHEMA CONSOLIDADO: nfe_v4.00_consolidado.xsd
______________________________________________________________________________
Propósito:
  Consolidar todos os schemas necessários para validação das mensagens XML
  da Nota Fiscal Eletrônica (NF-e) versão 4.00, garantindo compatibilidade
  total com o parser Xerces (Java) e eliminando conflitos de namespace entre
  os schemas oficiais da SEFAZ e o schema W3C XML Digital Signature (xmldsig).

Base técnica:
  - Nota Técnica 2025.002
  - Leiaute PL_010b v1.30 (SEFAZ)
  - Aderência à especificação W3C XMLSchema 1.0 (Xerces-J)

Escopo:
  Ambientes: DEV / HOMOLOGAÇÃO / PRODUÇÃO
  Projeto: Borurio ERP Fiscal BR

Autor:
  Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
  Revisão 3.1.5 — Inclusão do elemento raiz NFe para compatibilidade Xerces
==============================================================================
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns="http://www.portalfiscal.inf.br/nfe"
           targetNamespace="http://www.portalfiscal.inf.br/nfe"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- =============================================================
         1. IMPORTAÇÃO — Assinatura Digital (W3C XMLDSig v1.01 ajustado)
         ============================================================= -->
    <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
               schemaLocation="xmldsig-core-schema_v1.01-ajustado.xsd"/>

    <!-- =============================================================
         2. INCLUSÕES — Schemas nacionais padronizados
         ============================================================= -->
    <xs:include schemaLocation="leiauteNFe_v4.00-ajustado.xsd"/>
    <xs:include schemaLocation="procNFe_v4.00.xsd"/>

    <!-- =============================================================
         3. ELEMENTOS RAIZ — Estruturas principais da NF-e 4.00
         ============================================================= -->

    <!-- 3.1 Pedido de Autorização -->
    <xs:element name="enviNFe" type="TEnviNFe"/>

    <!-- 3.2 Retorno da SEFAZ -->
    <xs:element name="retEnviNFe" type="TRetEnviNFe"/>

    <!-- 🔴 CORREÇÃO CRÍTICA -->
    <!-- 3.3 Nota Fiscal Eletrônica -->
    <xs:element name="NFe" type="TNFe">
        <xs:annotation>
            <xs:documentation>
                Elemento raiz da NF-e conforme leiaute oficial.
                Necessário para validação direta do XML NFe no parser Xerces.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <!-- =============================================================
         4. PROCESSO COMPLETO (procNFe)
         ============================================================= -->
    <!-- Já incluído via procNFe_v4.00.xsd -->

    <!-- =============================================================
         5. FALLBACK (uso controlado em testes)
         ============================================================= -->
    <xs:complexType name="TExtraFallback">
        <xs:sequence>
            <xs:any namespace="##other"
                    processContents="skip"
                    minOccurs="0"
                    maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>