<?xml version="1.0" encoding="UTF-8"?>
<!--
==============================================================================
SCHEMA CONSOLIDADO: nfe_v4.00_consolidado.xsd
______________________________________________________________________________
Propósito:
  Consolidar todos os schemas necessários para validação das mensagens XML
  da Nota Fiscal Eletrônica (NF-e) versão 4.00, garantindo compatibilidade
  total com o parser Xerces (Java) e eliminando conflitos de namespace entre
  os schemas oficiais da SEFAZ e o schema W3C XML Digital Signature (xmldsig).

Base técnica:
  - Nota Técnica 2025.002
  - Leiaute PL_010b v1.30 (SEFAZ)
  - Aderência à especificação W3C XMLSchema 1.0 (Xerces-J)

Escopo:
  Ambientes: DEV / HOMOLOGAÇÃO / PRODUÇÃO
  Projeto: Borurio ERP Fiscal BR

Autor:
  Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
  Revisão 3.1.3 — Correção definitiva de paths relativos (classpath seguro)
==============================================================================
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns="http://www.portalfiscal.inf.br/nfe"
           targetNamespace="http://www.portalfiscal.inf.br/nfe"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- =============================================================
         1. IMPORTAÇÃO — Assinatura Digital (W3C XMLDSig v1.01 ajustado)
         ============================================================= -->
    <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
               schemaLocation="../custom/xmldsig-core-schema_v1.01-ajustado.xsd"/>

    <!-- =============================================================
         2. INCLUSÕES — Schemas nacionais padronizados
         =============================================================
         Estrutura:
           • leiauteNFe_v4.00-ajustado.xsd → estrutura principal e tipos
           • procNFe_v4.00.xsd              → processo completo (NF-e + protocolo)
    -->
    <xs:include schemaLocation="../custom/leiauteNFe_v4.00-ajustado.xsd"/>
    <xs:include schemaLocation="../custom/procNFe_v4.00.xsd"/>

    <!-- =============================================================
         3. ELEMENTOS RAIZ — Estruturas principais da NF-e 4.00
         ============================================================= -->

    <!-- 3.1 Pedido de Concessão de Autorização de Uso -->
    <xs:element name="enviNFe" type="TEnviNFe">
        <xs:annotation>
            <xs:documentation>
                Elemento raiz "enviNFe" — representa o pedido de autorização
                de uso da NF-e transmitido à SEFAZ.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <!-- 3.2 Retorno do Pedido de Autorização de Uso -->
    <xs:element name="retEnviNFe" type="TRetEnviNFe">
        <xs:annotation>
            <xs:documentation>
                Elemento "retEnviNFe" — representa o retorno da SEFAZ após o
                processamento do pedido de autorização da NF-e.
                Estrutura conforme leiaute PL_010b v1.30:
                • tpAmb, verAplic, cStat, xMotivo, cUF, dhRecbto, infRec?
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <!-- 3.3 Processo completo da NF-e -->
    <!--
        O elemento "procNFe" é declarado em procNFe_v4.00.xsd,
        incluído acima — não deve ser redeclarado.
    -->

    <!-- =============================================================
         4. ESTRUTURA OPCIONAL — Fallback para mocks e extensões
         =============================================================
         Propósito:
           Evitar falhas durante testes unitários e mocks de integração
           que possuam elementos fora da ordem SEFAZ, sem quebrar a
           conformidade principal do schema.
    -->
    <xs:complexType name="TExtraFallback">
        <xs:sequence>
            <xs:any namespace="##other"
                    processContents="skip"
                    minOccurs="0"
                    maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
