# =============================================================================
# TEMPLATE — Variáveis de ambiente DEV local (Borurio ERP Fiscal BR)
# =============================================================================
# Copie este arquivo para docker/env/.env.dev e preencha os valores reais.
# NUNCA commite o arquivo .env.dev — ele contém senhas e segredos locais.
# Este template não contém nenhum valor sensível — é seguro commitar.
# =============================================================================

# ---------------------------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
TZ=America/Sao_Paulo
SERVER_PORT=8080
JAVA_OPTS=-Xms256m -Xmx512m

# ---------------------------------------------------------------------------
# MYSQL — consumido pelo container borurio-mysql-dev
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=borurio_fiscal_dev
MYSQL_USER=borurio
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# DB — aliases de conveniência
# ---------------------------------------------------------------------------
DB_HOST=borurio-mysql-dev
DB_PORT=3306
DB_NAME=borurio_fiscal_dev
DB_USER=borurio
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Datasource Spring Boot — consumido pelo container borurio-web-dev
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://borurio-mysql-dev:3306/borurio_fiscal_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=borurio
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ---------------------------------------------------------------------------
# Redis — consumido pelo container borurio-web-dev
# ---------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=borurio-redis-dev
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=5000

REDIS_HOST=borurio-redis-dev
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO — consumido pelo container borurio-minio-dev
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MINIO_ENDPOINT=http://borurio-minio-dev:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---------------------------------------------------------------------------
# JWT — consumido pelo container borurio-web-dev
# ---------------------------------------------------------------------------
SECURITY_JWT_SECRET=
SECURITY_JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------------------
# Certificado digital A1 — consumido pelo container borurio-web-dev
# ATENÇÃO: Use apenas o certificado de homologação (nunca certificado real/PRD)
# ---------------------------------------------------------------------------
FISCAL_CERT_PATH=/app/certificados/pfx/certificado-dev.pfx
FISCAL_CERT_PASSWORD=

# Truststore SEFAZ (ICP-Brasil)
SEFAZ_TRUSTSTORE=/app/certificados/truststore/sefaz-truststore.jks
SEFAZ_TRUSTSTORE_PASSWORD=

# ---------------------------------------------------------------------------
# NF-e / SEFAZ
# ATENÇÃO: NFE_TPAMB=2 obrigatório em DEV — nunca usar 1 (produção)
# ---------------------------------------------------------------------------
NFE_TPAMB=2
NFE_EMITENTE_PADRAO=

# ---------------------------------------------------------------------------
# Actuator e Log
# ---------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
LOGGING_LEVEL_ROOT=DEBUG
LOGGING_LEVEL_BR_COM_BORURIO=DEBUG
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-dev.log
