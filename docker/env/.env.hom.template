# =============================================================================
# TEMPLATE — Variáveis de ambiente HOM (Borurio ERP Fiscal BR)
# =============================================================================
# Copie este arquivo para docker/env/.env.hom e preencha os valores reais.
# NUNCA commite o arquivo .env.hom — ele contém senhas e segredos de produção.
# =============================================================================

# ---------------------------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=hom
TZ=America/Sao_Paulo
SERVER_PORT=8081
JAVA_OPTS=-Xms256m -Xmx512m

# ---------------------------------------------------------------------------
# MYSQL — consumido pelo container borurio-mysql-hom
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=borurio_fiscal_hom
MYSQL_USER=borurio
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# DB — aliases de conveniência (para scripts e referência)
# ---------------------------------------------------------------------------
DB_HOST=borurio-mysql-hom
DB_PORT=3306
DB_NAME=borurio_fiscal_hom
DB_USER=borurio
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Datasource Spring Boot — consumido pelo container borurio-web-hom
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://borurio-mysql-hom:3306/borurio_fiscal_hom?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=borurio
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ---------------------------------------------------------------------------
# Redis — consumido pelo container borurio-web-hom
# ---------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=borurio-redis-hom
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=5000

# Redis — aliases de conveniência
REDIS_HOST=borurio-redis-hom
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO — consumido pelo container borurio-minio-hom (nomes exatos do MinIO)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MinIO — consumido pelo container borurio-web-hom (cliente Spring/MinIO da app)
MINIO_ENDPOINT=http://borurio-minio-hom:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---------------------------------------------------------------------------
# JWT — consumido pelo container borurio-web-hom
# ---------------------------------------------------------------------------
SECURITY_JWT_SECRET=
SECURITY_JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------------------
# Certificado digital A1 — consumido pelo container borurio-web-hom
# ---------------------------------------------------------------------------
FISCAL_CERT_PATH=/app/certificados/pfx/certificado-jcho.pfx
FISCAL_CERT_PASSWORD=

# Truststore SEFAZ (ICP-Brasil)
SEFAZ_TRUSTSTORE=/app/certificados/truststore/sefaz-truststore.jks
SEFAZ_TRUSTSTORE_PASSWORD=

# ---------------------------------------------------------------------------
# NF-e / SEFAZ
# ---------------------------------------------------------------------------
NFE_TPAMB=2
NFE_EMITENTE_PADRAO=

# ---------------------------------------------------------------------------
# Rate limiting — RateLimitInterceptor (borurio-web)
# ---------------------------------------------------------------------------
# Limite por IP na janela de 60s. Login (/auth/login) usa RATE_LIMIT_LOGIN_MAX,
# separado. Default do código (RateLimitInterceptor.java) é 30 se a variável
# não for definida. Valor de HOM ajustado após relato de 429 no /emitir com
# volume real do OMS (2026-07-30) — reavaliar para PRD com teste de carga.
RATE_LIMIT_EMITIR_MAX=300

# ---------------------------------------------------------------------------
# Actuator e Log
# ---------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_BORURIO=INFO
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-hom.log
