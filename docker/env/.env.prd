# =============================================================================
# Ambiente: PRD - Produção / Homologação
# Projeto: Borurio ERP Fiscal BR
# Finalidade: Configurações oficiais utilizadas em produção e homologação
# Autor: Bruno Ribeiro — DevSecOps / Java Fullstack
# Última Revisão: 15/10/2025
# =============================================================================

# -----------------------------------------------------------------------------
# Perfil ativo e fuso horário
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prd
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Banco de Dados MySQL 8.4
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=secure_root_2025
MYSQL_DATABASE=borurio_fiscal
MYSQL_USER=borurio
MYSQL_PASSWORD=secure_pass_2025
MYSQL_HOST=borurio-mysql
MYSQL_PORT=3306

# Configuração JDBC para o Spring Boot (deve coincidir com application-prd.yml)
SPRING_DATASOURCE_URL=jdbc:mysql://borurio-mysql:3306/borurio_fiscal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# -----------------------------------------------------------------------------
# Redis – Cache e Filas de Sessão
# -----------------------------------------------------------------------------
REDIS_HOST=borurio-redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO – Armazenamento de XMLs, Certificados e Logs Fiscais
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=borurio_admin
MINIO_ROOT_PASSWORD=borurio@prd2025
MINIO_URL=http://borurio-minio:9000
MINIO_CONSOLE_URL=http://borurio-minio:9001

# -----------------------------------------------------------------------------
# Certificado Digital A1 (NF-e Produção)
# -----------------------------------------------------------------------------
CERT_PASSWORD=senha_certificado_prd
CERT_PATH=/opt/borurio/certs/certificado-a1.pfx

# -----------------------------------------------------------------------------
# E-mail Corporativo (SMTP de Produção)
# -----------------------------------------------------------------------------
MAIL_HOST=borurio-mail
MAIL_PORT=587
MAIL_USER=notificacoes@borurio.com.br
MAIL_PASS=prdmail@2025
MAIL_FROM=notificacoes@borurio.com.br

# -----------------------------------------------------------------------------
# JVM – Parâmetros de Performance, Localização e Logging
# -----------------------------------------------------------------------------
JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo -Dspring.output.ansi.enabled=ALWAYS
LOG_PATH=/var/log/borurio

# -----------------------------------------------------------------------------
# Spring Boot Actuator – Endpoints de Saúde e Monitoramento
# -----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SERVER_PORT=8081

# -----------------------------------------------------------------------------
# Docker / Pipeline Metadata
# -----------------------------------------------------------------------------
APP_NAME=borurio-fiscal-prd
APP_VERSION=1.0.0
BUILD_DATE=2025-10-15
MAINTAINER=Bruno Ribeiro <dev@borurio.com.br>

# -----------------------------------------------------------------------------
# CORS – Controle de Origem e Segurança de API
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://erp.borurio.com.br
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Observações e Boas Práticas
# -----------------------------------------------------------------------------
# 1. Este arquivo é consumido exclusivamente pelo docker-compose.prd.yml.
# 2. Nunca versionar credenciais reais ou certificados (.pfx) no Git.
# 3. O certificado digital A1 deve estar montado em:
#       /opt/borurio/certs/certificado-a1.pfx
# 4. Os logs persistem em:
#       /var/log/borurio/
# 5. Recomenda-se o uso de secrets externos em pipeline CI/CD.
# -----------------------------------------------------------------------------
