# =============================================================================
# Ambiente PRD - Produção | Borurio ERP Fiscal BR
# Configurações oficiais de produção do ERP Fiscal Borurio Brasil.
# =============================================================================

SPRING_PROFILES_ACTIVE=prd
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# MySQL - Banco de Dados de Produção
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=secure_root_2025
MYSQL_DATABASE=borurio_fiscal
MYSQL_USER=borurio
MYSQL_PASSWORD=secure_pass_2025
MYSQL_HOST=borurio-mysql
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Redis - Cache e Filas de Sessão
# -----------------------------------------------------------------------------
REDIS_HOST=borurio-redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO - Armazenamento de Arquivos (Compatível S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=borurio_admin
MINIO_ROOT_PASSWORD=borurio@prd2025
MINIO_URL=http://borurio-minio:9000
MINIO_CONSOLE_URL=http://borurio-minio:9001

# -----------------------------------------------------------------------------
# Mailpit - Captura de E-mails (SMTP / Web UI)
# -----------------------------------------------------------------------------
MAIL_HOST=borurio-mailpit
MAIL_PORT=1025
MAIL_USER=notificacoes@borurio.com
MAIL_PASS=prdmail@2025

# -----------------------------------------------------------------------------
# Configuração da JVM (Java 17 / Spring Boot 3.3.x)
# -----------------------------------------------------------------------------
JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Endpoints de Saúde / Monitoramento (Spring Boot Actuator)
# -----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SERVER_PORT=8081
