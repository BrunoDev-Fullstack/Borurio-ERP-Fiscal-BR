# ==============================================================================
# AMBIENTE DE PRODUÇÃO REAL — BORURIO ERP FISCAL BR
# ==============================================================================
# Propósito: Execução do ambiente de produção (tpAmb=1) para emissão de NF-e reais
# junto à SEFAZ-SP. Usado pelo docker-compose.prd.yml.
# Última Revisão: 04/12/2025
# ==============================================================================

# ------------------------------------------------------------------------------
# PERFIL ATIVO E CONFIGURAÇÕES GERAIS
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prd
TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# MYSQL — BANCO DE DADOS (PRODUÇÃO)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=secure_root_2025
MYSQL_DATABASE=borurio_fiscal_prd
MYSQL_USER=borurio
MYSQL_PASSWORD=H4ck3r123

# O Compose define o host automaticamente como nome do serviço
MYSQL_HOST=borurio-mysql-prd
MYSQL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------------------
# REDIS — CACHE E SESSÕES (PRODUÇÃO)
# ------------------------------------------------------------------------------
REDIS_HOST=borurio-redis-prd
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MINIO — ARMAZENAMENTO DE XMLs E LOGS (PRODUÇÃO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=borurio_admin
MINIO_ROOT_PASSWORD=borurio@prd2025
MINIO_URL=http://borurio-minio-prd:9000
MINIO_CONSOLE_URL=http://borurio-minio-prd:9001

# ------------------------------------------------------------------------------
# CERTIFICADO DIGITAL A1 (NF-e Produção)
# ------------------------------------------------------------------------------
CERT_PATH=/app/certificados/pfx/certificado-jcho-keystore.p12
CERT_PASS=Jcho@2025!

# ------------------------------------------------------------------------------
# SMTP — E-MAIL CORPORATIVO (PRODUÇÃO)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.borurio.com.br
MAIL_PORT=587
MAIL_USER=notificacoes@borurio.com.br
MAIL_PASS=prdmail@2025
MAIL_FROM=notificacoes@borurio.com.br
MAIL_TLS_ENABLED=true
MAIL_AUTH=true

# ------------------------------------------------------------------------------
# JVM — PARÂMETROS DE PERFORMANCE E LOCALIZAÇÃO
# ------------------------------------------------------------------------------
JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo

# ------------------------------------------------------------------------------
# SPRING BOOT ACTUATOR — MONITORAMENTO E DIAGNÓSTICO
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_SERVER_PORT=8281

# ------------------------------------------------------------------------------
# METADADOS — IDENTIFICAÇÃO DO BUILD
# ------------------------------------------------------------------------------
APP_NAME=borurio-web-prd
APP_VERSION=1.0.0
BUILD_DATE=2025-11-04
MAINTAINER="Bruno Ribeiro <dev@borurio.com.br>"

# ------------------------------------------------------------------------------
# LOGS — PRÁTICAS DEVSECOPS
# ------------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_BORURIO=INFO
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-prd.log

# ------------------------------------------------------------------------------
# MAPEAMENTO DE PORTAS EXTERNAS (DOCKER)
# ------------------------------------------------------------------------------
SERVER_PORT=8282
ACTUATOR_PORT=8281

# ------------------------------------------------------------------------------
# CORS — CONTROLE DE ORIGEM E SEGURANÇA DE API
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://erp.borurio.com.br
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# PARÂMETROS FISCAIS / SEFAZ-SP (tpAmb=1 - Produção)
# ------------------------------------------------------------------------------
NFE_TPAMB=1
NFE_SEFAZ_CERTIFICADO=${CERT_PATH}
NFE_SEFAZ_SENHA=${CERT_PASS}

# ------------------------------------------------------------------------------
# OBSERVAÇÕES E BOAS PRÁTICAS
# ------------------------------------------------------------------------------
# * Este arquivo é consumido exclusivamente pelo docker-compose.prd.yml.
# * Não versionar certificados (.pfx/.pem) em repositórios.
# * Utilizar secrets externos no CI/CD para variáveis sensíveis.
# * O host usado pelos serviços deve coincidir com os nomes Docker.
# * Logs persistem em /var/log/borurio.
# ==============================================================================

