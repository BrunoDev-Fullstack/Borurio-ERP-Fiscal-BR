# ==============================================================================
# AMBIENTE DE PRODUÇÃO REAL – BORURIO ERP FISCAL BR
# ------------------------------------------------------------------------------
# Ambiente oficial (tpAmb=1) para emissão de NF-e em Produção SEFAZ-SP.
# Padrão: Monólito Modular (Web inclui Core, App e Fiscal)
# Stack: Spring Boot 3.3.x | Java 17 | MySQL 8.4 | Redis 7.2 | MinIO | SMTP Real
# Autor: Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
# Última Revisão: 29/10/2025
# ==============================================================================

# ------------------------------------------------------------------------------
# PERFIL ATIVO E FUSO HORÁRIO
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prd
TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# MYSQL - BANCO DE DADOS (PRODUÇÃO)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=secure_root_2025
MYSQL_DATABASE=borurio_fiscal_prd
MYSQL_USER=borurio
MYSQL_PASSWORD=secure_pass_2025
MYSQL_HOST=borurio-mysql        # deve coincidir com o nome do serviço no docker-compose.yml
MYSQL_PORT=3306

# Configuração do Spring DataSource
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------------------
# REDIS - CACHE E SESSÕES (PRODUÇÃO)
# ------------------------------------------------------------------------------
REDIS_HOST=borurio-redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MINIO - ARMAZENAMENTO DE XMLs, CERTIFICADOS E LOGS (PRODUÇÃO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=borurio_admin
MINIO_ROOT_PASSWORD=borurio@prd2025
MINIO_URL=http://borurio-minio:9000
MINIO_CONSOLE_URL=http://borurio-minio:9001

# ------------------------------------------------------------------------------
# CERTIFICADO DIGITAL A1 (NF-e Produção)
# ------------------------------------------------------------------------------
CERT_PATH=/app/certificados/certificado-prd.pfx
CERT_PASS=SENHA_DO_CERTIFICADO_REAL

# ------------------------------------------------------------------------------
# SMTP REAL - E-MAIL CORPORATIVO (PRODUÇÃO)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.borurio.com.br
MAIL_PORT=587
MAIL_USER=notificacoes@borurio.com.br
MAIL_PASS=prdmail@2025
MAIL_FROM=notificacoes@borurio.com.br

# ------------------------------------------------------------------------------
# JVM - PARÂMETROS DE PERFORMANCE E LOCALIZAÇÃO
# ------------------------------------------------------------------------------
JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo -Dspring.output.ansi.enabled=ALWAYS

# ------------------------------------------------------------------------------
# SPRING BOOT ACTUATOR - MONITORAMENTO E DIAGNÓSTICO
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_SERVER_PORT=8281

# ------------------------------------------------------------------------------
# DOCKER / BUILD METADATA
# ------------------------------------------------------------------------------
APP_NAME=borurio-web-prd
APP_VERSION=1.0.0
BUILD_DATE=2025-10-29
MAINTAINER=Bruno Ribeiro <dev@borurio.com.br>

# ------------------------------------------------------------------------------
# SEGURANÇA E LOGS (PRÁTICAS DEVSECOPS)
# ------------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_BORURIO=INFO
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-prd.log

# ------------------------------------------------------------------------------
# MAPEAMENTO DE PORTAS EXTERNAS (DOCKER)
# ------------------------------------------------------------------------------
SERVER_PORT=8282
ACTUATOR_PORT=8281

# ------------------------------------------------------------------------------
# CORS – CONTROLE DE ORIGEM E SEGURANÇA DE API
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://erp.borurio.com.br
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# PARAMETROS FISCAIS / SEFAZ-SP (tpAmb=1 - Produção)
# ------------------------------------------------------------------------------
NFE_TPAMB=1
NFE_SEFAZ_CERTIFICADO=${CERT_PATH}
NFE_SEFAZ_SENHA=${CERT_PASS}

# ------------------------------------------------------------------------------
# OBSERVAÇÕES E BOAS PRÁTICAS
# ------------------------------------------------------------------------------
# 1. Este arquivo é consumido exclusivamente pelo docker-compose.yml (PRD).
# 2. Não versionar credenciais reais nem certificados (.pfx) no Git.
# 3. O certificado digital A1 deve ser montado no container em /app/certificados/.
# 4. Os logs persistem em /var/log/borurio/borurio-prd.log.
# 5. Recomenda-se uso de secrets externos em pipeline CI/CD.
# 6. Todos os hosts devem coincidir com os nomes dos serviços no docker-compose.
# ------------------------------------------------------------------------------
