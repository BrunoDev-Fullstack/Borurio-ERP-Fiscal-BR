# ==============================================================================
# AMBIENTE DEV / HOMOLOGAÇÃO — BORURIO ERP FISCAL BR
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev
TZ=America/Sao_Paulo
ENVIRONMENT_CLEAN=true

# ------------------------------------------------------------------
# MYSQL
# ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=SENHA_NOVA_DO_ROOT
MYSQL_DATABASE=borurio_fiscal_dev
MYSQL_USER=borurio
MYSQL_PASSWORD=H4ck3r123

MYSQL_HOST=borurio-mysql
MYSQL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------
REDIS_HOST=borurio-redis
REDIS_PORT=6379

# ------------------------------------------------------------------
# MINIO
# ------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_URL=http://borurio-minio:9000
MINIO_CONSOLE_URL=http://borurio-minio:9001

# ------------------------------------------------------------------
# MAIL
# ------------------------------------------------------------------
MAIL_HOST=borurio-mailpit
MAIL_PORT=1025
MAIL_USER=test@borurio.com
MAIL_PASS=devmail@2025
MAIL_FROM=test@borurio.com
MAIL_TLS_ENABLED=false
MAIL_AUTH=false

# ------------------------------------------------------------------
# CERTIFICADO A1
# ------------------------------------------------------------------
CERT_PATH=/app/certificados/certificado-hom.pfx
CERT_PASS=123456

# ------------------------------------------------------------------
# JVM
# ------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo

# ------------------------------------------------------------------
# ACTUATOR
# ------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env,beans,loggers
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SERVER_PORT=8081

# ------------------------------------------------------------------
# APP
# ------------------------------------------------------------------
APP_NAME=borurio-web-dev
APP_VERSION=1.0.0

# ------------------------------------------------------------------
# LOGS
# ------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_BORURIO=DEBUG
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-dev.log

# ------------------------------------------------------------------
# PORTAS
# ------------------------------------------------------------------
SERVER_PORT=8080
ACTUATOR_PORT=8081

# ------------------------------------------------------------------
# SEFAZ
# ------------------------------------------------------------------
NFE_TPAMB=2
NFE_SEFAZ_CERTIFICADO=${CERT_PATH}
NFE_SEFAZ_SENHA=${CERT_PASS}

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true