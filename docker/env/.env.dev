# =============================================================================
# AMBIENTE DEV - DESENVOLVIMENTO / HOMOLOGAÇÃO
# Projeto: Borurio ERP Fiscal BR
# Finalidade: Configurações locais utilizadas durante o desenvolvimento e testes
# Autor: Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
# =============================================================================

# ---------------------------------------------------------------------------
# PERFIL ATIVO E FUSO HORÁRIO
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# MYSQL - BANCO DE DADOS LOCAL (DESENVOLVIMENTO)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=SENHA_NOVA_DO_ROOT
MYSQL_DATABASE=borurio_fiscal_dev
MYSQL_USER=borurio
MYSQL_PASSWORD=H4ck3r123
MYSQL_HOST=borurio-mysql-dev
MYSQL_PORT=3306

# Configuração do Spring DataSource
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ---------------------------------------------------------------------------
# REDIS - CACHE E SESSÕES
# ---------------------------------------------------------------------------
REDIS_HOST=borurio-redis-dev
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MINIO - ARMAZENAMENTO LOCAL COMPATÍVEL COM S3
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_URL=http://borurio-minio-dev:9000
MINIO_CONSOLE_URL=http://borurio-minio-dev:9001

# ---------------------------------------------------------------------------
# MAILPIT - SMTP LOCAL (E-MAILS DE TESTE)
# ---------------------------------------------------------------------------
MAIL_HOST=borurio-mailpit-dev
MAIL_PORT=1025
MAIL_USER=test@borurio.com
MAIL_PASS=devmail@2025

# ---------------------------------------------------------------------------
# JVM - PARÂMETROS DE PERFORMANCE E LOCALIZAÇÃO
# ---------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo -Dspring.output.ansi.enabled=ALWAYS

# ---------------------------------------------------------------------------
# SPRING BOOT ACTUATOR - MONITORAMENTO E DIAGNÓSTICO
# ---------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env,beans,loggers
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SERVER_PORT=8081

# ---------------------------------------------------------------------------
# DOCKER / BUILD METADATA
# ---------------------------------------------------------------------------
APP_NAME=borurio-web-dev
APP_VERSION=1.0.0
BUILD_DATE=2025-10-28
MAINTAINER=Bruno Ribeiro <dev@borurio.com.br>

# ---------------------------------------------------------------------------
# SEGURANÇA E LOGS (PRÁTICAS DEVSECOPS)
# ---------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_BORURIO=DEBUG
LOGGING_FILE_PATH=/var/log/borurio
LOGGING_FILE_NAME=borurio-dev.log

# ---------------------------------------------------------------------------
# MAPEAMENTO DE PORTAS EXTERNAS (DOCKER)
# ---------------------------------------------------------------------------
SERVER_PORT=8082
ACTUATOR_PORT=8081
