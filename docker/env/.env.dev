# =============================================================================
# Ambiente DEV - Desenvolvimento / Homologação | Borurio ERP Fiscal BR
# Configurações locais utilizadas em ambiente de desenvolvimento.
# =============================================================================

SPRING_PROFILES_ACTIVE=dev
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# MySQL - Banco de Dados Local (Desenvolvimento)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=SENHA_NOVA_DO_ROOT
MYSQL_DATABASE=borurio_fiscal_dev
MYSQL_USER=borurio
MYSQL_PASSWORD=H4ck3r123
MYSQL_HOST=borurio-mysql
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Redis - Cache e Sessões de Desenvolvimento
# -----------------------------------------------------------------------------
REDIS_HOST=borurio-redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO - Armazenamento Local (Compatível S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=H4ck3r123
MINIO_URL=http://borurio-minio:9000
MINIO_CONSOLE_URL=http://borurio-minio:9001

# -----------------------------------------------------------------------------
# Mailpit - Servidor SMTP Local de Testes
# -----------------------------------------------------------------------------
MAIL_HOST=borurio-mailpit
MAIL_PORT=1025
MAIL_USER=test@borurio.com
MAIL_PASS=devmail@2025

# -----------------------------------------------------------------------------
# JVM - Parâmetros de Performance para Ambiente DEV
# -----------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Endpoints de Saúde / Monitoramento (Spring Boot Actuator)
# -----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_SERVER_PORT=8081
