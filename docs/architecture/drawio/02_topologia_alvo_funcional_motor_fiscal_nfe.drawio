        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;themeVariables\&quot;: {\n    \&quot;fontFamily\&quot;: \&quot;Verdana\&quot;,\n    \&quot;fontSize\&quot;: \&quot;16px\&quot;,\n    \&quot;primaryTextColor\&quot;: \&quot;#111827\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#111827\&quot;\n  }\n}}%%\n\nflowchart LR\n\n    TITULO[\&quot;BORURIO ERP LOGÍSTICO + FISCAL BR — TOPOLOGIA ALVO FUNCIONAL&lt;br/&gt;Página 01B — ERP Brasileiro com Motor Fiscal NF-e\&quot;]\n\n    subgraph ENTRADA[\&quot;Atores / Entrada\&quot;]\n        USR[\&quot;Usuário interno&lt;br/&gt;Operação / Fiscal\&quot;]\n        ERP[\&quot;ERP / Sistema externo&lt;br/&gt;Pedido / Venda / Faturamento\&quot;]\n        API_CLIENT[\&quot;Swagger / API Client&lt;br/&gt;Postman / Integração\&quot;]\n        IMPL[\&quot;Equipe de implantação&lt;br/&gt;Validação e suporte\&quot;]\n    end\n\n    subgraph WEB[\&quot;borurio-web&lt;br/&gt;Camada REST / Entrada\&quot;]\n        REST[\&quot;API REST principal&lt;br/&gt;Spring Boot 3.3.2&lt;br/&gt;Controllers REST\&quot;]\n        AUTH[\&quot;Autenticação e Segurança&lt;br/&gt;JWT&lt;br/&gt;Spring Security&lt;br/&gt;/auth/login\&quot;]\n        SWAGGER[\&quot;Swagger / OpenAPI&lt;br/&gt;Documentação técnica&lt;br/&gt;Testes controlados\&quot;]\n        NFE_CTRL[\&quot;NfeEnvioController&lt;br/&gt;POST /api/fiscal/nfe/enviar\&quot;]\n    end\n\n    subgraph APP[\&quot;borurio-app&lt;br/&gt;Regras de Negócio ERP\&quot;]\n        CLIENTE[\&quot;Clientes&lt;br/&gt;Emitente / Destinatário\&quot;]\n        PRODUTO[\&quot;Produtos&lt;br/&gt;NCM / CFOP\&quot;]\n        PEDIDO[\&quot;Pedido / Venda&lt;br/&gt;Operação comercial\&quot;]\n        REGRAS[\&quot;Regras fiscais nacionais&lt;br/&gt;validações de negócio\&quot;]\n    end\n\n    subgraph CORE[\&quot;borurio-core&lt;br/&gt;Núcleo Compartilhado\&quot;]\n        RESULT[\&quot;Resposta padrão&lt;br/&gt;code / message / data\&quot;]\n        UTILS[\&quot;Utilitários comuns&lt;br/&gt;validações / exceptions\&quot;]\n        CONFIG[\&quot;Configurações compartilhadas\&quot;]\n    end\n\n    subgraph FISCAL[\&quot;borurio-fiscal&lt;br/&gt;Motor Fiscal NF-e\&quot;]\n        ORQ[\&quot;NfeOrquestradorService&lt;br/&gt;orquestra o fluxo fiscal\&quot;]\n        XML[\&quot;XML NF-e 4.00&lt;br/&gt;entrada completa ou montagem interna\&quot;]\n        XSD[\&quot;XsdValidator&lt;br/&gt;validação contra schemas oficiais\&quot;]\n        SIGN[\&quot;AssinaturaXmlService&lt;br/&gt;assinatura digital XMLDSIG\&quot;]\n        LOTE[\&quot;enviNFe&lt;br/&gt;montagem do lote\&quot;]\n        SOAP[\&quot;NfeTransmitService&lt;br/&gt;SOAP 1.2 / TLS\&quot;]\n        RECIBO[\&quot;Consulta Recibo&lt;br/&gt;consReciNFe\&quot;]\n        STATUS[\&quot;Status Autorização&lt;br/&gt;cStat / protocolo\&quot;]\n    end\n\n    subgraph INFRA[\&quot;Infraestrutura / Persistência\&quot;]\n        MYSQL[\&quot;MySQL 8.4&lt;br/&gt;borurio_fiscal&lt;br/&gt;tabelas ERP / fiscal\&quot;]\n        REDIS[\&quot;Redis 7.2&lt;br/&gt;cache / suporte runtime\&quot;]\n        MINIO[\&quot;MinIO&lt;br/&gt;armazenamento de XML&lt;br/&gt;logs / evidências\&quot;]\n        FLYWAY[\&quot;Flyway&lt;br/&gt;versionamento V001-V008+\&quot;]\n        DOCKER[\&quot;Docker Compose&lt;br/&gt;DEV / HOM / PRD\&quot;]\n    end\n\n    subgraph CERT[\&quot;Segurança Fiscal / Certificados\&quot;]\n        A1[\&quot;Certificado A1&lt;br/&gt;PKCS12 / PFX\&quot;]\n        TRUST[\&quot;Truststore ICP-Brasil&lt;br/&gt;cadeia SEFAZ\&quot;]\n        TLS[\&quot;SSLContext TLSv1.2&lt;br/&gt;comunicação segura\&quot;]\n    end\n\n    subgraph EXT[\&quot;Integrações Externas\&quot;]\n        SEFAZ_HOM[\&quot;SEFAZ-SP Homologação&lt;br/&gt;validação e testes\&quot;]\n        SEFAZ_PRD[\&quot;SEFAZ Produção&lt;br/&gt;emissão oficial\&quot;]\n        NCM[\&quot;Tabela NCM oficial&lt;br/&gt;regras fiscais\&quot;]\n    end\n\n    subgraph OBS[\&quot;Operação / Observabilidade\&quot;]\n        ACT[\&quot;Actuator&lt;br/&gt;/actuator/health&lt;br/&gt;/actuator/info\&quot;]\n        LOGS[\&quot;Logs técnicos&lt;br/&gt;startup / fiscal / SEFAZ\&quot;]\n        HEALTH[\&quot;Healthcheck Docker&lt;br/&gt;container healthy\&quot;]\n        REL[\&quot;Relatórios técnicos&lt;br/&gt;evidências / implantação\&quot;]\n    end\n\n    TITULO --&gt; ENTRADA\n\n    USR --&gt; REST\n    ERP --&gt; REST\n    API_CLIENT --&gt; SWAGGER\n    IMPL --&gt; SWAGGER\n\n    REST --&gt; AUTH\n    REST --&gt; NFE_CTRL\n    NFE_CTRL --&gt; ORQ\n\n    REST --&gt; APP\n    APP --&gt; CORE\n    APP --&gt; FISCAL\n\n    CLIENTE --&gt; REGRAS\n    PRODUTO --&gt; REGRAS\n    PEDIDO --&gt; REGRAS\n    REGRAS --&gt; ORQ\n\n    ORQ --&gt; XML\n    XML --&gt; XSD\n    XSD --&gt; SIGN\n    SIGN --&gt; LOTE\n    LOTE --&gt; SOAP\n    SOAP --&gt; RECIBO\n    RECIBO --&gt; STATUS\n\n    FISCAL --&gt; MYSQL\n    APP --&gt; MYSQL\n    WEB --&gt; REDIS\n    FISCAL --&gt; MINIO\n    MYSQL --&gt; FLYWAY\n    WEB --&gt; DOCKER\n\n    SIGN --&gt; A1\n    SOAP --&gt; TLS\n    TLS --&gt; TRUST\n    TRUST --&gt; SEFAZ_HOM\n    TRUST --&gt; SEFAZ_PRD\n\n    SOAP --&gt; SEFAZ_HOM\n    SOAP -. \&quot;após homologação\&quot; .-&gt; SEFAZ_PRD\n    PRODUTO --&gt; NCM\n\n    WEB --&gt; ACT\n    ACT --&gt; HEALTH\n    WEB --&gt; LOGS\n    FISCAL --&gt; LOGS\n    STATUS --&gt; REL\n\n    classDef titulo fill:#F8FAFC,stroke:#111827,stroke-width:2px,color:#111827,font-size:22px,font-weight:bold;\n    classDef entrada fill:#EAF2FF,stroke:#1D4ED8,stroke-width:2px,color:#0F172A;\n    classDef web fill:#ECFDF5,stroke:#15803D,stroke-width:2px,color:#0F172A;\n    classDef app fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#0F172A;\n    classDef core fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#0F172A;\n    classDef fiscal fill:#FEE2E2,stroke:#DC2626,stroke-width:2px,color:#7F1D1D;\n    classDef infra fill:#ECFEFF,stroke:#0E7490,stroke-width:2px,color:#0F172A;\n    classDef cert fill:#E0F2FE