        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;flowchart\&quot;: {\n    \&quot;nodeSpacing\&quot;: 85,\n    \&quot;rankSpacing\&quot;: 110,\n    \&quot;curve\&quot;: \&quot;linear\&quot;,\n    \&quot;htmlLabels\&quot;: true\n  },\n  \&quot;themeVariables\&quot;: {\n    \&quot;fontFamily\&quot;: \&quot;Verdana\&quot;,\n    \&quot;fontSize\&quot;: \&quot;16px\&quot;,\n    \&quot;primaryTextColor\&quot;: \&quot;#111827\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#374151\&quot;,\n    \&quot;background\&quot;: \&quot;#ffffff\&quot;\n  }\n}}%%\n\nflowchart TB\n\nT1[\&quot;&lt;b&gt;BORURIO ERP LOGÍSTICO + FISCAL BR&lt;/b&gt;\&quot;]:::title\nT2[\&quot;Página 06A — Topologia de CI/CD, Versionamento, Evidências e Deploy\&quot;]:::subtitle\nT3[\&quot;Esteira técnica para build, validação, segurança, empacotamento, entrega e rastreabilidade\&quot;]:::subtitle\n\nT1 --&gt; T2\nT2 --&gt; T3\n\nsubgraph CAMADA1[\&quot; \&quot;]\ndirection LR\n\nDEV[\&quot;&lt;b&gt;Desenvolvimento Local&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nIntelliJ IDEA&lt;br/&gt;\nJava 17&lt;br/&gt;\nSpring Boot 3.3.2&lt;br/&gt;\nMaven Multi-Module&lt;br/&gt;\nPowerShell&lt;br/&gt;\nDocker Desktop\&quot;]:::dev\n\nGIT[\&quot;&lt;b&gt;Controle de Versão&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nGit&lt;br/&gt;\nGitHub&lt;br/&gt;\nBranch principal&lt;br/&gt;\nCommits técnicos&lt;br/&gt;\nTags de marco&lt;br/&gt;\nHistórico rastreável\&quot;]:::git\n\nDOCS[\&quot;&lt;b&gt;Documentação Técnica&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\ndocs/architecture&lt;br/&gt;\ndocs/report&lt;br/&gt;\nTopologias drawio&lt;br/&gt;\nExports PNG&lt;br/&gt;\nRelatórios técnicos&lt;br/&gt;\nEvidências de execução\&quot;]:::docs\n\nend\n\nT3 --&gt; DEV\nDEV --&gt;|commit / push| GIT\nDEV --&gt;|gera documentação| DOCS\n\nsubgraph CAMADA2[\&quot; \&quot;]\ndirection LR\n\nBUILD[\&quot;&lt;b&gt;Build Maven&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nmvn clean compile&lt;br/&gt;\nmvn clean test&lt;br/&gt;\nmvn clean package&lt;br/&gt;\nValidação multi-módulo&lt;br/&gt;\nborurio-core&lt;br/&gt;\nborurio-app&lt;br/&gt;\nborurio-fiscal&lt;br/&gt;\nborurio-web\&quot;]:::build\n\nTEST[\&quot;&lt;b&gt;Testes Automatizados&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nJUnit 5&lt;br/&gt;\nTestes de assinatura&lt;br/&gt;\nTestes de XSD&lt;br/&gt;\nTestes de serviços&lt;br/&gt;\nSmoke tests REST&lt;br/&gt;\nSwagger / API Client\&quot;]:::test\n\nSEC[\&quot;&lt;b&gt;Segurança DevSecOps&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nOWASP Dependency Check&lt;br/&gt;\nControle de secrets&lt;br/&gt;\n.gitignore reforçado&lt;br/&gt;\nJWT&lt;br/&gt;\nCertificado A1 fora do Git&lt;br/&gt;\nAuditoria de dependências\&quot;]:::sec\n\nend\n\nGIT --&gt;|aciona pipeline| BUILD\nBUILD --&gt; TEST\nTEST --&gt; SEC\n\nsubgraph CAMADA3[\&quot; \&quot;]\ndirection LR\n\nDOCKER[\&quot;&lt;b&gt;Empacotamento Docker&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nDockerfile multi-stage&lt;br/&gt;\nImagem borurio-web&lt;br/&gt;\nImagem fiscal quando aplicável&lt;br/&gt;\nJava runtime 17&lt;br/&gt;\nBuild reproduzível\&quot;]:::docker\n\nCOMPOSE[\&quot;&lt;b&gt;Orquestração&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\ndocker-compose.dev.yml&lt;br/&gt;\ndocker-compose.hom.yml&lt;br/&gt;\ndocker-compose.prd.yml&lt;br/&gt;\nMySQL&lt;br/&gt;\nRedis&lt;br/&gt;\nMinIO&lt;br/&gt;\nRede Docker segregada\&quot;]:::compose\n\nENV[\&quot;&lt;b&gt;Configuração por Ambiente&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\n.env.dev&lt;br/&gt;\n.env.hom&lt;br/&gt;\n.env.prd&lt;br/&gt;\nSPRING_PROFILES_ACTIVE&lt;br/&gt;\nVariáveis de banco&lt;br/&gt;\nVariáveis de certificado\&quot;]:::env\n\nend\n\nSEC --&gt; DOCKER\nDOCKER --&gt; COMPOSE\nENV --&gt; COMPOSE\n\nsubgraph CAMADA4[\&quot; \&quot;]\ndirection LR\n\nDEVENV[\&quot;&lt;b&gt;Deploy DEV&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nValidação local&lt;br/&gt;\nSwagger&lt;br/&gt;\nActuator&lt;br/&gt;\nLogs de container&lt;br/&gt;\nSmoke tests&lt;br/&gt;\nCorreções rápidas\&quot;]:::devenv\n\nHOMENV[\&quot;&lt;b&gt;Deploy HOM&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nHomologação interna&lt;br/&gt;\nSEFAZ Homologação&lt;br/&gt;\nValidação fiscal&lt;br/&gt;\nAssinatura XML&lt;br/&gt;\nRetorno cStat&lt;br/&gt;\nEvidências\&quot;]:::homenv\n\nPRDENV[\&quot;&lt;b&gt;Deploy PRD&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nProdução controlada&lt;br/&gt;\nSEFAZ Produção&lt;br/&gt;\nCertificado oficial&lt;br/&gt;\nBackup&lt;br/&gt;\nMonitoramento&lt;br/&gt;\nRollback\&quot;]:::prdenv\n\nend\n\nCOMPOSE --&gt; DEVENV\nDEVENV --&gt;|promove após estabilização| HOMENV\nHOMENV --&gt;|promove após homologação| PRDENV\n\nsubgraph CAMADA5[\&quot; \&quot;]\ndirection LR\n\nLOGS[\&quot;&lt;b&gt;Logs e Observabilidade&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\ndocker logs&lt;br/&gt;\nSpring Boot logs&lt;br/&gt;\nLogs fiscais NF-e&lt;br/&gt;\nActuator health/info&lt;br/&gt;\nFalhas SOAP/TLS&lt;br/&gt;\nFalhas de assinatura\&quot;]:::logs\n\nEVID[\&quot;&lt;b&gt;Evidências de Entrega&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nPNG das topologias&lt;br/&gt;\nRelatórios técnicos&lt;br/&gt;\nXML original&lt;br/&gt;\nXML assinado&lt;br/&gt;\nRetorno SEFAZ&lt;br/&gt;\nPrints e comandos\&quot;]:::evid\n\nCHECK[\&quot;&lt;b&gt;Critérios de Aceite&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;\nBuild OK&lt;br/&gt;\nTestes OK&lt;br/&gt;\nContainers UP / healthy&lt;br/&gt;\nSwagger acessível&lt;br/&gt;\nAutenticação validada&lt;br/&gt;\nFluxo fiscal validado\&quot;]:::check\n\nend\n\nDEVENV --&gt; LOGS\nHOMENV --&gt; LOGS\nPRDENV --&gt; LOGS\n\nLOGS --&gt; EVID\nDOCS --&gt; EVID\nEVID --&gt; CHECK\n\nOBS[\&quot;&lt;b&gt;Observação&lt;/b&gt;&lt;br/&gt;\nEsta topologia fecha o pacote arquitetural, mostrando como o código Java/Spring Boot sai do desenvolvimento local, passa por build, testes, segurança, Docker, ambientes DEV/HOM/PRD e gera evidências técnicas para implantação.\&quot;]:::note\n\nCHECK --&gt; OBS\n\nclassDef title fill:#ffffff,stroke:#ffffff,color:#111827,font-size:30px,font-weight:bold;\nclassDef subtitle fill:#ffffff,stroke:#ffffff,color:#4b5563,font-size:18px;\n\nclassDef dev fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2px;\nclassDef git fill:#f5f3ff,stroke:#7c3aed,color:#5b21b6,stroke-width:2px;\nclassDef docs fill:#f9fafb,stroke:#6b7280,color:#111827,stroke-width:2px;\n\nclassDef build fill:#ecfdf5,stroke:#16a34a,color:#166534,stroke-width:2px;\nclassDef test fill:#ecfeff,stroke:#0891b2,color:#155e75,stroke-width:2px;\nclassDef sec fill:#fff7ed,stroke:#ea580c,color:#9a3412,stroke-width:2px;\n\nclassDef docker fill:#eef2ff,stroke:#4f46e5,color:#3730a3,stroke-width:2px;\nclassDef compose fill:#f0fdf4,stroke:#22c55e,color:#166534,stroke-width:2px;\nclassDef env fill:#fefce8,stroke:#ca8a04,color:#854d0e,stroke-width:2px;\n\nclassDef devenv fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2px;\nclassDef homenv fill:#ecfeff,stroke:#0891b2,color:#155e75,stroke-width:2px;\nclassDef prdenv fill:#fef2f2,stroke:#dc2626,color:#991b1b,stroke-width:2px;\n\nclassDef logs fill:#f3f4f6,stroke:#6b7280,color:#374151,stroke-width:2px;\nclassDef evid fill:#fff7ed,stroke:#f97316,color:#9a3412,stroke-width:2px;\nclassDef check fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;\nclassDef note fill:#f3f4f6,stroke:#9ca3af,color:#374151,stroke-width:1px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="35sB87HvkO7CeWYhbCh_-53">
