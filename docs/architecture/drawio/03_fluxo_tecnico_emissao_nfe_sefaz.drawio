        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;themeVariables\&quot;: {\n    \&quot;fontFamily\&quot;: \&quot;Verdana\&quot;,\n    \&quot;fontSize\&quot;: \&quot;16px\&quot;,\n    \&quot;primaryTextColor\&quot;: \&quot;#111827\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#111827\&quot;\n  }\n}}%%\n\nflowchart LR\n\n    TITULO[\&quot;BORURIO ERP LOGÍSTICO + FISCAL BR — FLUXO TÉCNICO DE EMISSÃO NF-e&lt;br/&gt;Página 02 — XML, Assinatura, Lote, SOAP e SEFAZ\&quot;]\n\n    ERP[\&quot;ERP / Operação Comercial&lt;br/&gt;&lt;br/&gt;Pedido&lt;br/&gt;Venda&lt;br/&gt;Cliente&lt;br/&gt;Produto&lt;br/&gt;Tributação\&quot;]\n\n    API[\&quot;Entrada REST&lt;br/&gt;&lt;br/&gt;POST /api/fiscal/nfe/enviar&lt;br/&gt;Endpoint oficial de emissão NF-e\&quot;]\n\n    CTRL[\&quot;NfeEnvioController&lt;br/&gt;&lt;br/&gt;Recebe requisição REST&lt;br/&gt;Valida entrada inicial&lt;br/&gt;Encaminha para orquestração\&quot;]\n\n    ORQ[\&quot;NfeOrquestradorService&lt;br/&gt;&lt;br/&gt;Coordena o fluxo fiscal&lt;br/&gt;Centraliza validação, assinatura e transmissão&lt;br/&gt;Não deve transmitir direto sem assinar\&quot;]\n\n    XML[\&quot;XML NF-e 4.00&lt;br/&gt;&lt;br/&gt;ide&lt;br/&gt;emit&lt;br/&gt;dest&lt;br/&gt;det&lt;br/&gt;imposto&lt;br/&gt;total&lt;br/&gt;transp\&quot;]\n\n    XSD[\&quot;XsdValidator&lt;br/&gt;&lt;br/&gt;Valida XML contra schemas oficiais&lt;br/&gt;NF-e 4.00&lt;br/&gt;leiauteNFe&lt;br/&gt;tiposBasico\&quot;]\n\n    SIGN[\&quot;AssinaturaXmlService&lt;br/&gt;&lt;br/&gt;Assinatura XMLDSIG&lt;br/&gt;Certificado A1&lt;br/&gt;Reference URI #NFe&lt;br/&gt;DigestValue&lt;br/&gt;SignatureValue&lt;br/&gt;X509Certificate\&quot;]\n\n    LOTE[\&quot;Montagem enviNFe&lt;br/&gt;&lt;br/&gt;idLote&lt;br/&gt;indSinc&lt;br/&gt;NFe assinada&lt;br/&gt;versão 4.00\&quot;]\n\n    SOAP[\&quot;NfeTransmitService&lt;br/&gt;&lt;br/&gt;SOAP 1.2&lt;br/&gt;TLSv1.2&lt;br/&gt;nfeDadosMsg&lt;br/&gt;NFeAutorizacao4\&quot;]\n\n    SEFAZ[\&quot;SEFAZ-SP Homologação&lt;br/&gt;&lt;br/&gt;Recebe lote&lt;br/&gt;Valida schema&lt;br/&gt;Valida assinatura&lt;br/&gt;Processa autorização\&quot;]\n\n    RET[\&quot;Retorno SEFAZ&lt;br/&gt;&lt;br/&gt;retEnviNFe&lt;br/&gt;recibo&lt;br/&gt;cStat&lt;br/&gt;xMotivo\&quot;]\n\n    CONS[\&quot;Consulta Recibo&lt;br/&gt;&lt;br/&gt;consReciNFe&lt;br/&gt;Consulta processamento&lt;br/&gt;Aguarda resultado fiscal\&quot;]\n\n    FINAL[\&quot;Resultado Fiscal&lt;br/&gt;&lt;br/&gt;Autorizada: cStat 100&lt;br/&gt;Rejeitada: cStat específico&lt;br/&gt;Protocolo&lt;br/&gt;Motivo&lt;br/&gt;XML autorizado\&quot;]\n\n    CERT[\&quot;Certificado A1&lt;br/&gt;&lt;br/&gt;Arquivo: certificado-jcho.pfx&lt;br/&gt;Senha via variável de ambiente&lt;br/&gt;Alias: 1&lt;br/&gt;SSLContext TLSv1.2 OK\&quot;]\n\n    STORAGE[\&quot;Persistência / Evidências&lt;br/&gt;&lt;br/&gt;MySQL&lt;br/&gt;MinIO&lt;br/&gt;XML original&lt;br/&gt;XML assinado&lt;br/&gt;Retorno SEFAZ&lt;br/&gt;Logs técnicos\&quot;]\n\n    ERRO[\&quot;Tratamento de Falhas&lt;br/&gt;&lt;br/&gt;XML inválido&lt;br/&gt;Assinatura inválida&lt;br/&gt;Rejeição SEFAZ&lt;br/&gt;Falha SOAP/TLS&lt;br/&gt;Timeout / indisponibilidade\&quot;]\n\n    TITULO --&gt; ERP\n    ERP --&gt; API\n    API --&gt; CTRL\n    CTRL --&gt; ORQ\n    ORQ --&gt; XML\n    XML --&gt; XSD\n    XSD --&gt; SIGN\n    SIGN --&gt; LOTE\n    LOTE --&gt; SOAP\n    SOAP --&gt; SEFAZ\n    SEFAZ --&gt; RET\n    RET --&gt; CONS\n    CONS --&gt; FINAL\n\n    CERT --&gt; SIGN\n    CERT --&gt; SOAP\n\n    XML --&gt; STORAGE\n    SIGN --&gt; STORAGE\n    LOTE --&gt; STORAGE\n    RET --&gt; STORAGE\n    FINAL --&gt; STORAGE\n\n    XSD -. \&quot;falha de validação\&quot; .-&gt; ERRO\n    SIGN -. \&quot;falha de assinatura\&quot; .-&gt; ERRO\n    SOAP -. \&quot;falha de comunicação\&quot; .-&gt; ERRO\n    SEFAZ -. \&quot;rejeição fiscal\&quot; .-&gt; ERRO\n    ERRO --&gt; STORAGE\n\n    classDef titulo fill:#F8FAFC,stroke:#111827,stroke-width:2px,color:#111827,font-size:22px,font-weight:bold;\n    classDef entrada fill:#EAF2FF,stroke:#1D4ED8,stroke-width:2px,color:#0F172A;\n    classDef api fill:#ECFDF5,stroke:#15803D,stroke-width:2px,color:#0F172A;\n    classDef fiscal fill:#FEE2E2,stroke:#DC2626,stroke-width:2px,color:#7F1D1D;\n    classDef sefaz fill:#FFF7ED,stroke:#EA580C,stroke-width:2px,color:#0F172A;\n    classDef cert fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0F172A;\n    classDef storage fill:#F3F4F6,stroke:#6B7280,stroke-width:2px,color:#374151;\n    classDef final fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#14532D;\n    classDef erro fill:#FEE2E2,stroke:#B91C1C,stroke-width:3px,color:#7F1D1D;\n\n    class TITULO titulo;\n    class ERP entrada;\n    class API,CTRL api;\n    class ORQ,XML,XSD,SIGN,LOTE,SOAP fiscal;\n    class SEFAZ,RET,CONS sefaz;\n    class CERT cert;\n    class STORAGE storage;\n    class FINAL final;\n    class ERRO erro;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cOCeY3eOrXek0RRMBxYF-1">
