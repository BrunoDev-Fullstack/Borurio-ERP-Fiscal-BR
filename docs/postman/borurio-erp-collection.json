              "raw": "{\n  \"cnpj\": \"12345678000195\",\n  \"razaoSocial\": \"Empresa Atualizada Ltda\",\n  \"nomeFantasia\": \"Empresa Atualizada\",\n  \"ie\": \"123456789012\",\n  \"logradouro\": \"Rua das Flores\",\n  \"numero\": \"200\",\n  \"bairro\": \"Centro\",\n  \"municipio\": \"São Paulo\",\n  \"uf\": \"SP\",\n  \"cep\": \"01001000\",\n  \"codMunicipio\": 3550308,\n  \"crt\": 1,\n  \"tpAmb\": 2\n}"
