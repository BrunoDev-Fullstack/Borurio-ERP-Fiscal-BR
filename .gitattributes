# =============================================================================
# .gitattributes — Borurio ERP Fiscal BR
# All text files are stored as LF in the repository.
# Prevents CRLF from corrupting shell scripts running inside Linux containers.
# =============================================================================

# Default: auto-detect text vs binary; store text as LF
* text=auto eol=lf

# -------------------------
# Java / JVM source
# -------------------------
*.java        text eol=lf
*.kt          text eol=lf
*.groovy      text eol=lf
*.scala       text eol=lf

# -------------------------
# Build descriptors
# -------------------------
pom.xml       text eol=lf
*.xml         text eol=lf

# -------------------------
# Spring / configuration
# -------------------------
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf
*.env         text eol=lf

# -------------------------
# Web / data
# -------------------------
*.json        text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf

# -------------------------
# Documentation
# -------------------------
*.md          text eol=lf
*.txt         text eol=lf
*.adoc        text eol=lf

# -------------------------
# SQL
# -------------------------
*.sql         text eol=lf

# -------------------------
# Docker / shell
# -------------------------
Dockerfile    text eol=lf
*.sh          text eol=lf

# -------------------------
# Windows scripts — CRLF on checkout (native format)
# -------------------------
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# -------------------------
# Binary — no line-ending conversion
# -------------------------
*.pfx         binary
*.p12         binary
*.jks         binary
*.jar         binary
*.class       binary
*.war         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.svg         binary
*.zip         binary
*.tar.gz      binary
*.drawio      binary
