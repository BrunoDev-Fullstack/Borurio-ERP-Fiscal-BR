<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ==========================================================
         MÓDULO: borurio-app
         DESCRIÇÃO: Camada de aplicação e regras de negócio
         SISTEMA: ERP Fiscal Borurio Brasil / Galpão
         TECNOLOGIAS: Java 17, Spring Boot 3.3.x, MyBatis, Redis, MySQL
         PADRÃO: DevSecOps — build seguro e modular
         ========================================================== -->

    <modelVersion>4.0.0</modelVersion>

    <!-- ==========================================================
         HERANÇA (POM principal do projeto)
         ========================================================== -->
    <parent>
        <groupId>br.com.borurio</groupId>
        <artifactId>borurio-erp-br</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>borurio-app</artifactId>
    <packaging>jar</packaging>
    <name>Borurio App - Módulo de Negócios</name>
    <description>Camada de aplicação, cadastros e regras de negócio do ERP Fiscal Borurio Brasil</description>

    <!-- ==========================================================
         PROPRIEDADES GERAIS
         ========================================================== -->
    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.3.2</spring.boot.version>
        <mybatis.version>3.0.3</mybatis.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ==========================================================
         DEPENDÊNCIAS DO PROJETO
         ========================================================== -->
    <dependencies>

        <!-- ======================================================
             MÓDULOS INTERNOS
             ====================================================== -->
        <!-- Módulo CORE (respostas, enums e utilitários compartilhados) -->
        <dependency>
            <groupId>br.com.borurio</groupId>
            <artifactId>borurio-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ======================================================
             FRAMEWORK SPRING BOOT
             ====================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Spring Web (para controladores REST e MVC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Validação (Bean Validation / Jakarta Validation API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Cache e Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- ======================================================
             PERSISTÊNCIA E BANCO DE DADOS
             ====================================================== -->
        <!-- MyBatis (mapeamento objeto-relacional leve e flexível) -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.version}</version>
        </dependency>

        <!-- Driver oficial MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ======================================================
             UTILITÁRIOS E SUPORTE
             ====================================================== -->
        <!-- Lombok (reduz código boilerplate: getters, setters, builders) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons Lang (funções utilitárias de strings, objetos, datas) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <!-- Apache Commons Collections (manipulação avançada de coleções) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>

        <!-- ======================================================
             DEPENDÊNCIAS DE TESTE
             ====================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring.boot.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ==========================================================
         CONFIGURAÇÃO DE BUILD
         ========================================================== -->
    <build>
        <plugins>

            <!-- ==================================================
                 COMPILADOR JAVA
                 ================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ==================================================
                 SPRING BOOT (empacotamento e execução)
                 ================================================== -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>br.com.borurio.app.App</mainClass>
                    <excludeDevtools>false</excludeDevtools>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
