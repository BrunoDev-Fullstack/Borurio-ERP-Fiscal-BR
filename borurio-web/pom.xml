<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- =============================================================================
         MÓDULO: Borurio ERP Web
         Função: API REST central do ERP Fiscal Borurio Brasil
         Stack: Java 17 | Spring Boot 3.3.2 | MyBatis | MySQL 8.4 | Redis | Flyway | Actuator | Swagger | Logback
         Autor: Bruno Ribeiro — Desenvolvedor Fullstack / DevSecOps
         ============================================================================= -->

    <modelVersion>4.0.0</modelVersion>

    <!-- Herança do POM principal -->
    <parent>
        <groupId>br.com.borurio</groupId>
        <artifactId>borurio-erp-br</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>borurio-web</artifactId>
    <packaging>jar</packaging>
    <name>Borurio ERP Web</name>
    <description>API REST central do ERP Fiscal Borurio Brasil — NF-e, Auditoria e Integrações SEFAZ-SP</description>

    <!-- =============================================================================
         PROPRIEDADES DO PROJETO
         ============================================================================= -->
    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.3.2</spring.boot.version>
        <flyway.version>10.18.0</flyway.version>
        <mysql.connector.version>8.4.0</mysql.connector.version>
        <springdoc.version>2.6.0</springdoc.version>
        <owasp.version>9.0.9</owasp.version>
        <surefire.version>3.2.5</surefire.version>
        <jjwt.version>0.11.5</jjwt.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- =============================================================================
         REPOSITÓRIOS
         ============================================================================= -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <!-- =============================================================================
         DEPENDÊNCIAS PRINCIPAIS
         ============================================================================= -->
    <dependencies>

        <!-- ===========================================================
             MÓDULOS INTERNOS DO ERP (Core, App, Fiscal)
             =========================================================== -->
        <dependency>
            <groupId>br.com.borurio</groupId>
            <artifactId>borurio-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>br.com.borurio</groupId>
            <artifactId>borurio-app</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>br.com.borurio</groupId>
            <artifactId>borurio-fiscal</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ===========================================================
             SPRING BOOT CORE / WEB / ACTUATOR / VALIDATION
             =========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===========================================================
             SPRING SECURITY + JWT (Autenticação e Autorização)
             =========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===========================================================
             PERSISTÊNCIA / MIGRAÇÃO / CACHE
             =========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <exclusions>
                <!-- Evita duplicação de Flyway -->
                <exclusion>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- MinIO (Armazenamento de Arquivos Fiscais e Certificados) -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.11</version>
        </dependency>

        <!-- ===========================================================
             DOCUMENTAÇÃO OPENAPI / SWAGGER
             =========================================================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===========================================================
             LOGGING (Logback - provider SLF4J)
             =========================================================== -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- ===========================================================
             UTILITÁRIOS PADRÕES (Java Nativo e Apache)
             =========================================================== -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.5.0-M2</version>
        </dependency>

        <!-- Lombok (somente em tempo de compilação) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===========================================================
             TESTES UNITÁRIOS E INTEGRAÇÃO (JUnit 5)
             =========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <!-- =============================================================================
         CONFIGURAÇÃO DE BUILD E PLUGINS
         ============================================================================= -->
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>

            <!-- Compilador Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- JUnit 5 (Surefire) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>br.com.borurio.web.Application</mainClass>
                    <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency Check -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${owasp.version}</version>
                <configuration>
                    <failBuildOnCVSS>7.0</failBuildOnCVSS>
                    <format>HTML</format>
                    <outputDirectory>${project.build.directory}/security-reports</outputDirectory>
                    <skipProvidedScope>true</skipProvidedScope>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
