<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- =============================================================================
         LOGBACK – AMBIENTE PRODUÇÃO (ROBUSTO)
         ============================================================================= -->

    <!-- =============================================================================
         PROPRIEDADES (COM FALLBACK)
         ============================================================================= -->
    <property name="LOG_PATH" value="${LOG_PATH:-/var/log/borurio}"/>
    <property name="APP_NAME" value="${APP_NAME:-borurio-erp-prd}"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- =============================================================================
         APPENDER: LOG PRINCIPAL
         ============================================================================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <append>true</append>
    </appender>

    <!-- =============================================================================
         APPENDER: ERROS
         ============================================================================= -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>
            <maxHistory>15</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>

        <append>true</append>
    </appender>

    <!-- =============================================================================
         APPENDER: SEFAZ
         ============================================================================= -->
    <appender name="SEFAZ_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/sefaz-integration.log</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/sefaz-integration.%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <append>true</append>
    </appender>

    <!-- =============================================================================
         ASYNC
         ============================================================================= -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- =============================================================================
         ROOT
         ============================================================================= -->
    <root level="INFO">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <!-- =============================================================================
         INFRA
         ============================================================================= -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

    <!-- =============================================================================
         APP
         ============================================================================= -->
    <logger name="br.com.borurio" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- =============================================================================
         SEFAZ
         ============================================================================= -->
    <logger name="br.com.borurio.fiscal"
            level="${LOGGING_LEVEL_BR_COM_BORURIO_FISCAL:-INFO}"
            additivity="false">
        <appender-ref ref="SEFAZ_FILE"/>
    </logger>

    <logger name="br.com.borurio.fiscal.soap"
            level="${LOGGING_LEVEL_BR_COM_BORURIO_FISCAL_SOAP:-WARN}"
            additivity="false">
        <appender-ref ref="SEFAZ_FILE"/>
    </logger>

</configuration>