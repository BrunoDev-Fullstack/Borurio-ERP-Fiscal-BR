<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <!-- ==========================================================================================
         LOGBACK – AMBIENTE DE PRODUÇÃO (tpAmb=1)
         Projeto: Borurio ERP Fiscal BR
         Autor: Bruno Ribeiro — DevSecOps / Fullstack Java
         Ambiente: PRD – SEFAZ-SP Produção Real
         ========================================================================================== -->

    <!-- ==========================================================================================
         DEFINIÇÕES GERAIS
         ========================================================================================== -->
    <property name="LOG_PATH" value="/var/log/borurio"/>
    <property name="LOG_FILE" value="${LOG_PATH}/borurio-prd.log"/>

    <!-- ==========================================================================================
         APPENDER: LOG PRINCIPAL
         ========================================================================================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/borurio-prd.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==========================================================================================
         APPENDER: LOG DE ERROS
         ========================================================================================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/borurio-prd-error.log</file>
        <append>true</append>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/borurio-prd-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>15</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==========================================================================================
         APPENDER: LOG SEFAZ (AUDITORIA FISCAL)
         ========================================================================================== -->
    <appender name="SEFAZ_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/sefaz-integration.log</file>
        <append>true</append>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/sefaz-integration.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==========================================================================================
         APPENDER: ASSÍNCRONO (PRINCIPAL)
         ========================================================================================== -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ==========================================================================================
         ROOT LOGGER
         ========================================================================================== -->
    <root level="INFO">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <!-- ==========================================================================================
         LOGGER: DOMÍNIO PRINCIPAL
         ========================================================================================== -->
    <logger name="br.com.borurio" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- ==========================================================================================
         LOGGER: SEFAZ – SERVIÇOS FISCAIS
         ========================================================================================== -->
    <logger name="br.com.borurio.fiscal.service.impl.NfeStatusServiceImpl"
            level="INFO" additivity="false">
        <appender-ref ref="SEFAZ_FILE"/>
    </logger>

    <logger name="br.com.borurio.fiscal.service.impl.NfeTransmitServiceImpl"
            level="INFO" additivity="false">
        <appender-ref ref="SEFAZ_FILE"/>
    </logger>

    <!-- ==========================================================================================
         LOGGER OPCIONAL: SOAP / XML (CONTROLADO POR ENV)
         ========================================================================================== -->
    <logger name="br.com.borurio.fiscal.soap"
            level="${LOGGING_LEVEL_BR_COM_BORURIO_FISCAL_SOAP:INFO}"
            additivity="false">
        <appender-ref ref="SEFAZ_FILE"/>
    </logger>

</configuration>
