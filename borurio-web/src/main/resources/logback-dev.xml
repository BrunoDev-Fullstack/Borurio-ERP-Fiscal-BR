<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- =============================================================================
         CONFIGURAÇÃO LOGBACK – AMBIENTE DEV
         _____________________________________________________________________________
         Projeto: Borurio ERP
         Autor: Bruno Ribeiro — DevSecOps / Fullstack Java

         Objetivo:
         - Logs detalhados para desenvolvimento
         - Console + arquivo rotativo
         - Ideal para debugging e integração SEFAZ homologação
         ============================================================================= -->

    <!-- =============================================================================
         PROPRIEDADES
         ============================================================================= -->
    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="borurio-erp-dev"/>
    <property name="LOG_FILE" value="${LOG_PATH}/${APP_NAME}.log"/>

    <!-- =============================================================================
         PADRÃO DE LOG
         ============================================================================= -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- =============================================================================
         APPENDER: CONSOLE
         ============================================================================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- =============================================================================
         APPENDER: ARQUIVO ROTATIVO
         ============================================================================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_FILE}</file>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>

            <maxHistory>10</maxHistory>

            <totalSizeCap>200MB</totalSizeCap>

        </rollingPolicy>

        <append>true</append>

    </appender>

    <!-- =============================================================================
         ROOT LOGGER
         ============================================================================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- =============================================================================
         LOGGER PRINCIPAL DA APLICAÇÃO
         ============================================================================= -->
    <logger name="br.com.borurio" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- =============================================================================
         LOGGER FISCAL (NF-e / SEFAZ)
         ============================================================================= -->
    <logger name="br.com.borurio.fiscal"
            level="${LOGGING_LEVEL_BR_COM_BORURIO_FISCAL:DEBUG}"
            additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

</configuration>