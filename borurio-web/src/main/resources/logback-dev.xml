<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- =============================================================================
         CONFIGURAÇÃO LOGBACK – AMBIENTE DEV / HOMOLOGAÇÃO
         _____________________________________________________________________________
         Projeto: Borurio ERP Fiscal BR
         Autor: Bruno Ribeiro — DevSecOps / Fullstack Java
         Descrição:
         - Unificado para perfis "dev" e "hom"
         - Exibe logs em console e arquivo rotativo
         - Ideal para testes locais e integração SEFAZ
         ============================================================================= -->

    <!-- =============================================================================
         DEFINIÇÕES GERAIS
         ============================================================================= -->
    <property name="LOG_PATH" value="logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/borurio-dev.log"/>

    <!-- =============================================================================
         APPENDER: CONSOLE
         ============================================================================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- =============================================================================
         APPENDER: ARQUIVO (ROTATIVO DIÁRIO)
         ============================================================================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/borurio-dev.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- =============================================================================
         ROOT LOGGER
         ============================================================================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- =============================================================================
         LOGGER: DOMÍNIO PRINCIPAL
         ============================================================================= -->
    <logger name="br.com.borurio" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- =============================================================================
         LOGGER: FISCAL / SEFAZ
         ============================================================================= -->
    <logger name="br.com.borurio.fiscal"
            level="${LOGGING_LEVEL_BR_COM_BORURIO_FISCAL:DEBUG}"
            additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

</configuration>
